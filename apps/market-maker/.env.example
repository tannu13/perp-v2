# Turn the bot off without editing turbo's task graph. A cold, empty book is a
# real UI state with real empty-state components behind it, and it has to stay
# demoable.
MM_ENABLED=true

API_URL=http://localhost:3000
WS_URL=ws://localhost:3010

# Two accounts, not one: a market maker cannot flatten its own inventory when it
# is the only liquidity on the book — see apps/market-maker/src/services/maker.ts.
MM_USERNAME=market-maker-bot
MM_PASSWORD=change-me-market-maker-bot-password
MM_NAME=Market Maker

TAKER_ENABLED=true
TAKER_USERNAME=flow-bot
TAKER_PASSWORD=change-me-flow-bot-password-value
TAKER_NAME=Flow Bot

# Empty = every market GET /markets returns. Otherwise a comma-separated list of
# slugs, e.g. SOL-USD,BTC-USD.
MM_MARKETS=

# 20 a side is also the engine's cap — `getMarketDepth` walks at most 20 levels,
# so anything above this is quoted, charged margin for, and never broadcast.
MM_LEVELS=20

# The touch. On BTC 2bps is ~$15; on SOL one tick is already a whole basis
# point, so the floor/ceil rounding widens it to two ticks on its own.
MM_SPREAD_BPS=2

# The gap between rungs, and so the size of the absolute price grid the whole
# ladder is snapped to. Rounded to a whole number of ticks (on SOL a tick is
# already a basis point, so it bottoms out at one tick).
#
# This is the churn knob and the reason the ladder is on a grid at all. An
# anchor-relative ladder moves every rung whenever the index moves: measured at
# 5227 `orders` inserts a minute, with depth frames caught mid-rebuild showing
# 20x3 books. On a grid the prices do not move until the reference crosses a
# cell, and then the whole ladder shifts by exactly one — so 19 of 20 rungs are
# already resting where they need to be. Widen this if the insert rate is still
# too high for a long-running demo box.
MM_LEVEL_STEP_BPS=0.5

MM_SKEW_BPS=3

# 20 levels a side across 3 markets: 900 * 20 = 18k notional per side per
# market, 108k across the book, 54k of margin locked at 2x. That has to stay
# clear of MM_BALANCE_FLOOR or the bot onramps itself every cycle.
MM_BASE_NOTIONAL=900

# Extra notional per level out from the touch. Zero by default, and the reason
# is churn, not taste: a level term on a ladder that SCROLLS fights itself —
# an order does not move when the book does, so its level creeps outward and
# the size the ladder wants there creeps with it, until the drift check
# requotes a batch of rungs. At 0.12 that is every third cell of one-way drift.
# Zero is also the more faithful model; in a real book depth belongs to the
# price, and MM_SIZE_JITTER (keyed by price) is what makes the column ragged.
MM_SIZE_GROWTH=0

# Raggedness, so the size column is not a visible linear ramp. Keyed by PRICE
# and not by level, so it scrolls with the book — a level-keyed jitter would
# want a new size for every rung the moment the ladder shifts a cell, which is
# the churn the grid exists to avoid.
MM_SIZE_JITTER=0.5

MM_LEVERAGE=2

# Every requote is an `orders` INSERT that is never deleted. This is the drift a
# rung tolerates before it is replaced, but it is CLAMPED to under half the gap
# to that rung's nearest neighbour — past that a resting order is
# indistinguishable from its neighbour and the ladder walks. So widen
# MM_LEVEL_STEP_BPS, not this, if the insert rate is too high
# for a long-running demo box.
MM_REQUOTE_BPS=3
MM_REFRESH_MS=600

# No mark-price frame within this window and the bot pulls its quotes rather
# than quoting off a stale anchor.
MM_STALE_MS=10000

MM_MAX_INVENTORY_NOTIONAL=20000
MM_BALANCE_FLOOR=60000
MM_TOPUP=250000

TAKER_MIN_MS=4000
TAKER_MAX_MS=15000
TAKER_NOTIONAL=500
TAKER_SLIPPAGE_PCT=1
