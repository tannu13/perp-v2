WS_SERVER_PORT=3010
REDIS_URL=redis://localhost:6379
ENGINE_RESPONSE_STREAM=engine-to-backend-trade-comms
LISTENER_GROUP=ws-server-group
LISTENER_GROUP_CONSUMER=ws-server

# Must be byte-identical to the backend's — ws-server verifies the tickets the
# backend mints, and HS256 verification is the same key as signing (Phase 13).
JWT_SECRET=replace-me-with-at-least-32-characters-of-secret
