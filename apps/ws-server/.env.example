WS_SERVER_PORT=3010
REDIS_URL=redis://localhost:6379
ENGINE_RESPONSE_STREAM=engine-to-backend-trade-comms

# dev | prod. This is the replica switch, not a logging level.
#
# A consumer group divides a stream between its members, so two ws-servers in
# one group each get about half the engine replies and every browser sees half
# a book. On `prod` the group name below is suffixed per process, which turns
# that division into fan-out and is the only thing that makes replicas > 1 safe.
#
# Leave it `dev` locally: `bun --watch` restarts on every save, and a fresh
# group per restart would litter Redis with the offsets of dead processes.
APP_STAGE=dev

# On `prod` this is a PREFIX — the real group is `ws-server-group-<uuid>`.
LISTENER_GROUP=ws-server-group
LISTENER_GROUP_CONSUMER=ws-server

# Must be byte-identical to the backend's — ws-server verifies the tickets the
# backend mints, and HS256 verification is the same key as signing (Phase 13).
JWT_SECRET=replace-me-with-at-least-32-characters-of-secret

# How often market state (depth, last price, index price) is published, in ms.
# The engine emits a full book per order event; this is what turns a maker's
# re-quote burst into a steady stream. 0 publishes every engine reply.
MARKET_STATE_INTERVAL_MS=100
