NODE_ENV=development
APP_STAGE=dev
REDIS_URL=redis://localhost:6379
INCOMING_STREAM=backend-to-engine-trade-comms
OUTGOING_STREAM=engine-to-backend-trade-comms
LISTENER_GROUP=engine-group
LISTENER_GROUP_CONSUMER=engine
# Local MinIO stands in for S3. Values match docker-compose.yml.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=fake-local-key
AWS_SECRET_ACCESS_KEY=fake-local-secret
AWS_BUCKET_NAME=perps-store-backups
MINIO_ENDPOINT=http://localhost:9000
