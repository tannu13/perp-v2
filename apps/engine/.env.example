NODE_ENV=development
APP_STAGE=dev
REDIS_URL=redis://localhost:6379
INCOMING_STREAM=backend-to-engine-trade-comms
OUTGOING_STREAM=engine-to-backend-trade-comms
LISTENER_GROUP=engine-group
LISTENER_GROUP_CONSUMER=engine
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=s30-perps-store-backups-bucket-410940411202-ap-south-1-an

# Local MinIO stands in for S3. Values match docker-compose.yml.
#
# All three below are required while NODE_ENV=development and must be left
# UNSET in AWS: MINIO_ENDPOINT is what points the client at MinIO instead of
# S3, and the key pair blocks the instance/task role the engine uses there.
MINIO_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=fake-local-key
AWS_SECRET_ACCESS_KEY=fake-local-secret
