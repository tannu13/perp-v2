APP_PORT=3000
NODE_ENV=development
APP_STAGE=dev
SALT_ROUNDS=10
# Must be at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-secret
DATABASE_URL=postgresql://perps_user:mysecretpasswordfordb@localhost:5432/perps_db
REDIS_URL=redis://localhost:6379
INCOMING_STREAM=engine-to-backend-trade-comms
OUTGOING_STREAM=backend-to-engine-trade-comms
# Browser origins allowed to call this API (comma-separated).
CORS_ORIGINS=http://localhost:3020
# How long a request waits for the engine before returning 503.
ENGINE_TIMEOUT_MS=5000
